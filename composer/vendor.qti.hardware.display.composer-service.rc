service vendor.qti.hardware.display.composer /vendor/bin/hw/vendor.qti.hardware.display.composer-service
    # t27b diagnostic experiment (stronger evidence now):
    #   the kernel side measures healthy: /dev/dri/card0, card0-DSI-1, sde-crtc-0..4, panel0-backlight are all present,
    #   and the panel driver is bound. composer gets -ENODEV, with DRMResMgr succeeding and only DRMMaster failing;
    #   this combination points to card0's master already being held by someone else.
    #   SurfaceFlinger is class main, composer is class hal (later). composer is moved up to class core here
    #   (earlier than main) to tell: if the DRM error goes away = ordering/ownership problem; if unchanged = -ENODEV has another cause.
    class core
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    onrestart restart feature_enabler_client
    socket pps stream 0660 system system
    task_profiles ServiceCapacityLow
